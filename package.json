{
  "name": "dsh-credit-expiry",
  "version": "0.8.1",
  "description": "积分到期面板：左侧边栏底栏一行显示 WorkBuddy、Trae、MiniMax Code、Qoder 四个积分池的余额与最近到期日，点开是完整页面（到期分布 + 积分消耗 + 积分会话）。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "credit",
    "quota",
    "expiry",
    "sidebar"
  ],
  "license": "MIT",
  "author": {
    "name": "526365412",
    "url": "https://github.com/526365412"
  },
  "icon": "./docs/icon.svg",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/526365412/dsh-credit-expiry.git"
  },
  "homepage": "https://github.com/526365412/dsh-credit-expiry#readme",
  "bugs": {
    "url": "https://github.com/526365412/dsh-credit-expiry/issues"
  },
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "docs/",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "index.json"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    },
    "manifestVersion": 1
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.2-rc.1 <0.3.0-0"
  },
  "scripts": {
    "test": "node --test test/money.test.mjs test/api.test.mjs test/index-json.test.mjs test/no-secrets.test.mjs test/i18n.test.mjs test/balance-order.test.mjs",
    "build:index": "node scripts/build-index.mjs",
    "check:index": "node scripts/build-index.mjs --check"
  }
}
